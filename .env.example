# Copy to .env and fill in with your Shopify store credentials
# Use one of these valid auth patterns:
# 1) Direct access token for a custom/private app:
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
# 2) App OAuth code exchange:
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret
# SHOPIFY_AUTH_CODE=shopify_oauth_code

# Required by the embedded web UI (npm run ui): SHOPIFY_CLIENT_ID is injected as the
# App Bridge API key, SHOPIFY_CLIENT_SECRET verifies session tokens, and
# SHOPIFY_STORE_DOMAIN must match the token's "dest" claim.
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret
# PORT=3000

# Optional: Anthropics / Claude SDK keys if you run the agent
ANTHROPIC_API_KEY=sk-...
CLAUDE_MODEL=claude-sonnet-5
